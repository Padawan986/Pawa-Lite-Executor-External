{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Pawa-Lite(Beta)V2",
    "version": "0.2.0",
    "identifier": "com.pawalite.betav2",
    "plugins": {
        "updater": {
            "active": true,
            "endpoints": [
                "https://raw.githubusercontent.com/Padawan986/Pawa-Lite-Executor-External/main/updates.json"
            ],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwNjk4MkE0QzNCMjlGRApSV1Q5S1R0TUtwZ0dBZUVpdTh6MklWdDhWV1lXZVZSQjRlSHJ6TitqejdHazUvbEVLaWlSUTRvdAo="
        }
    },
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../build"
    },
    "app": {
        "windows": [
            {
                "title": "Pawa-Lite(Beta)V2",
                "width": 770,
                "height": 475,
                "decorations": false,
                "transparent": false,
                "hiddenTitle": true,
                "titleBarStyle": "Overlay"
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "createUpdaterArtifacts": true,
        "icon": ["icons/icon.ico", "icons/icon.png", "icons/AppIcon.icns"],
        "resources": {
            "../../src/fapi_daemon.py": "fapi/fapi_daemon.py",
            "../../src/FAPI": "fapi/FAPI"
        }
    }
}
